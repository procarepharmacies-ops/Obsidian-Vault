# ─────────────────────────────────────────────────────────────────────────────
#  Hermes — ProCare AI Hub  |  Environment Configuration Template
#  Copy this file to ~/.hermes/.env and fill in your values.
#  Lines beginning with # are comments and are ignored.
# ─────────────────────────────────────────────────────────────────────────────

# ── AI Provider Keys ──────────────────────────────────────────────────────────

# Anthropic API key — required for Claude models.
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-YOUR_KEY_HERE

# Google AI Studio API key — required for Gemini models.
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaYOUR_KEY_HERE

# ── Hermes Core ───────────────────────────────────────────────────────────────

# Path to the SQLite database file.
# Default: ~/.hermes/hermes.db
# HERMES_DB_PATH=~/.hermes/hermes.db

# Log verbosity: DEBUG | INFO | WARNING | ERROR | CRITICAL
# Default: INFO
# HERMES_LOG_LEVEL=INFO

# ── ProCare Pharmacy ──────────────────────────────────────────────────────────

# Display name shown in the UI and reports.
# Default: ProCare Pharmacy
# PHARMACY_NAME=ProCare Pharmacy

# Webhook URL for outbound pharmacy notifications (optional).
# When not set, Hermes runs in demo/mock mode and prints notifications locally.
# PHARMACY_WEBHOOK_URL=https://your-webhook-endpoint.example.com/hermes
